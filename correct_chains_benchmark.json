g = umap.UMAP(n_neighbors=10, n_components=2, n_epochs=500, densmap=False, random_state=42).fit_transform(X)\\n\\n# compute KDTree distances for radius\\ntree = KDTree(X)\\ndists, _ = tree.query(X, k=3)\\nradius = 3 * np.mean(dists)\\n\\n# Geometry and local distortions\\ngeom = Geometry('brute', laplacian_method='geometric', affinity_kwds={'radius': radius}, adjacency_kwds={'radius': None, 'n_neighbors': 10}, laplacian_kwds={'scaling_epps': radius})\\nH, Hvv, Hs = local_distortions(embedding, X, geom)\\ncombined = bind_metric(embedding, Hvv, Hs)\\n# add cell type column as notebook did\\ncombined['cell_type'] = meta\\n\\nprint('Resulting dataframe shape:', combined.shape)\\nprint('Columns:', list(combined.columns))\\n\"})",
