  Thought:     Write a Python script in the workspace that loads the sam2.1_hiera_tiny checkpoint and runs the automatic mask generator on the groceries image, saving outputs.
  Action:      write_file({"relative_path":"workspace/generate_masks.py","content":"import numpy as np\nfrom PIL import Image\nimport torch\nimport os\n\nfrom sam2.build_sam import build_sam2\nfrom sam2.automatic_mask_generator import SAM2AutomaticMaskGenerator\n\n# paths\nckpt = os.path.join('checkpoints','sam2.1_hiera_tiny.pt')\nconfig = 'configs/sam2.1/sam2.1_hiera_t.yaml'\nimg_path = os.path.join('notebooks','images','groceries.jpg')\n\ndevice = 'cpu'\nprint('Loading model...')\nmodel = build_sam2(config_file=config, ckpt_path=ckpt, device=device, mode='eval')\nprint('Model loaded.')\n\n# create automatic mask generator\namg = SAM2AutomaticMaskGenerator(model,\n                                  points_per_side=32,\n                                  points_per_batch=64,\n                                  pred_iou_thresh=0.8,\n                                  stability_score_thresh=0.95,\n                                  mask_threshold=0.0,\n                                  crop_n_layers=0)\n\n# load image\nimg = Image.open(img_path).convert('RGB')\nimg_np = np.array(img)\n\nprint('Generating masks...')\nmasks = amg.generate(img_np)\nprint(f'Generated {len(masks)} masks')\n\n# save masks as numpy file (binary masks)\nnp_masks = [m['segmentation'].astype(np.uint8) for m in masks]\nnp.save('output_masks.npy', np_masks)\n\n# save first 5 masks as png overlays\nos.makedirs('masks_out', exist_ok=True)\nfor i, m in enumerate(np_masks[:5]):\n    im = Image.fromarray((m*255).astype('uint8'))\n    im.save(f'masks_out/mask_{i}.png')\n\n# also save a visualization overlay on original image for the first mask\nif len(np_masks)>0:\n    overlay = img.copy()\n    mask = np_masks[0]\n    overlay_arr = np.array(overlay)\n    # apply red tint where mask\n    overlay_arr[mask==1] = overlay_arr[mask==1] * 0.3 + np.array([255,0,0])*0.7\n    Image.fromarray(overlay_arr.astype('uint8')).save('masks_out/overlay_0.png')\n\nprint('Saved outputs: output_masks.npy and masks_out/*.png')\n"})
