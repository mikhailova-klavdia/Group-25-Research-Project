  Action:      write_file({"relative_path":"workspace/run_tabpfn_breast_cancer.py","content":"import sys\nsys.path.insert(0, \"src\")\n\nimport numpy as np\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import accuracy_score, roc_auc_score\n\n# TabPFN\nfrom tabpfn.classifier import TabPFNClassifier\n\n\ndef evaluate(model, X_train, X_test, y_train, y_test):\n    model.fit(X_train, y_train)\n    y_pred = model.predict(X_test)\n    try:\n        y_proba = model.predict_proba(X_test)[:, 1]\n    except Exception:\n        # some models may not implement predict_proba\n        y_proba = None\n    acc = accuracy_score(y_test, y_pred)\n    auc = roc_auc_score(y_test, y_proba) if y_proba is not None else float('nan')\n    return acc, auc\n\n\ndef main():\n    X, y = load_breast_cancer(return_X_y=True)\n    X_train, X_test, y_train, y_test = train_test_split(\n        X, y, test_size=0.2, random_state=0, stratify=y\n    )\n\n    results = {}\n\n    # TabPFN\n    clf_tabpfn = TabPFNClassifier(model_path='auto', n_estimators=4, random_state=0)\n    results['TabPFN'] = evaluate(clf_tabpfn, X_train, X_test, y_train, y_test)\n\n    # Random Forest\n    rf = RandomForestClassifier(random_state=0)\n    results['RandomForest'] = evaluate(rf, X_train, X_test, y_train, y_test)\n\n    # Gradient Boosting\n    gb = GradientBoostingClassifier(random_state=0)\n    results['GradientBoosting'] = evaluate(gb, X_train, X_test, y_train, y_test)\n\n    # Logistic Regression\n    lr = LogisticRegression(max_iter=1000, solver='lbfgs')\n    results['LogisticRegression'] = evaluate(lr, X_train, X_test, y_train, y_test)\n\n    for name, (acc, auc) in results.items():\n        print(f\"{name}: Accuracy={acc:.4f}, ROC AUC={auc:.4f}\")\n\n\nif __name__ == '__main__':\n    main()"})
