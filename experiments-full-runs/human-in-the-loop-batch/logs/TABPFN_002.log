  Action:      write_file({"relative_path":"workspace/run_tabpfn_california.py","content":"import os\nimport time\nfrom sklearn.datasets import fetch_california_housing\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_squared_error, r2_score\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor, HistGradientBoostingRegressor\nimport numpy as np\nfrom tabpfn import TabPFNRegressor\n\nRANDOM_STATE = 42\n\ndef evaluate_model(name, model, X_train, X_test, y_train, y_test):\n    t0 = time.time()\n    model.fit(X_train, y_train)\n    preds = model.predict(X_test)\n    mse = mean_squared_error(y_test, preds)\n    r2 = r2_score(y_test, preds)\n    dt = time.time() - t0\n    print(f\"{name}: MSE={mse:.4f}, R2={r2:.4f}, time={dt:.1f}s\")\n    return {'name': name, 'mse': mse, 'r2': r2, 'time': dt}\n\ndef main():\n    X, y = fetch_california_housing(return_X_y=True)\n    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=RANDOM_STATE)\n\n    results = []\n\n    # TabPFN (use a small ensemble for speed)\n    print(\"Running TabPFNRegressor (v2 model)...\")\n    tabpfn = TabPFNRegressor(n_estimators=8, random_state=RANDOM_STATE)\n    results.append(evaluate_model('TabPFNRegressor', tabpfn, X_train, X_test, y_train, y_test))\n\n    # Baselines\n    print('\nRunning baselines...')\n    results.append(evaluate_model('LinearRegression', LinearRegression(), X_train, X_test, y_train, y_test))\n    results.append(evaluate_model('RandomForest (100)', RandomForestRegressor(n_estimators=100, random_state=RANDOM_STATE, n_jobs=2), X_train, X_test, y_train, y_test))\n    results.append(evaluate_model('GradientBoosting (100)', GradientBoostingRegressor(n_estimators=100, random_state=RANDOM_STATE), X_train, X_test, y_train, y_test))\n    results.append(evaluate_model('HistGradientBoosting', HistGradientBoostingRegressor(random_state=RANDOM_STATE), X_train, X_test, y_train, y_test))\n\n    print('\nSummary (sorted by MSE):')\n    for r in sorted(results, key=lambda x: x['mse']):\n        print(f"{r['name']}: MSE={r['mse']:.4f}, R2={r['r2']:.4f}, time={r['time']:.1f}s")\n\nif __name__ == '__main__':\n    main()"})
