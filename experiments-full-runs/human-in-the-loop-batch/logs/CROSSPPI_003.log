ocess()\n\n# Make batch dimension and y placeholder\nligand_data.batch = torch.tensor([0])\nreceptor_data.batch = torch.tensor([0])\nligand_data.y = torch.tensor([0.0])\n\n# Load ensemble models and predict\nimport glob\n\nmodel_files = sorted(glob.glob('workspace/save/*.pth'))\nprint('Found model files:', model_files)\n\nmodel = PPI()\nmodel.eval()\n\npreds = []\nfor mf in model_files:\n    sd = torch.load(mf, map_location='cpu')\n    try:\n        model.load_state_dict(sd)\n    except Exception as e:\n        if 'model' in sd:\n            model.load_state_dict(sd['model'])\n        else:\n            model.load_state_dict(sd)\n    with torch.no_grad():\n        out = model(ligand_data, receptor_data)\n        val = out.squeeze().item()\n        preds.append(val)\n        print('Model', mf, 'pred:', val)\n\nif len(preds)==0:\n    print('No predictions')\nelse:\n    import numpy as np\n    ens = float(np.mean(preds))\n    print('Ensemble mean:', ens)\n    print(f\"Ensemble pKD: {ens:.2f}\")\n"})
