  Action:      write_file({"relative_path":"run_math_model_plots.py","content":"import numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nfrom scipy.stats import norm\nimport os\n\noutdir = 'GWAS-Epistasis-Bias/notebooks/math_model_plots/output'\nos.makedirs(outdir, exist_ok=True)\n\nn = 100_000\nx = 5.45\n\nrho_vals = np.linspace(-0.3, 0.3, 100)\nlambda_vals = np.linspace(0, 0.171, 100)\n\nRHO, LAMBDA = np.meshgrid(rho_vals, lambda_vals)\n\n# Model formulas\nMU = (RHO * np.sqrt(LAMBDA * n)) / np.sqrt(1 - LAMBDA * RHO**2)\nSIGMA = np.sqrt((1 - LAMBDA * RHO**2) / (1 - LAMBDA))\nalpha_t = norm.cdf(-(SIGMA*(x-MU))) + norm.cdf(-(SIGMA*(x+MU)))\nalpha_w = 2 * norm.cdf(-x)\nR = alpha_t/alpha_w\n\nprint(f\"alpha_w = {alpha_w}\")\n\nfig = plt.figure(figsize=(8, 6))\nplt.pcolormesh(RHO, LAMBDA, R, shading='auto', cmap='inferno')\nplt.colorbar(label=r'$R$  (for $x=\\pm5.45$)')\nplt.xlabel(r'$\\rho$')\nplt.ylabel(r'$\\lambda$')\nplt.title(fr'$n={n}$')\n# Save\nfig.savefig(os.path.join(outdir, f'lambda_rho_n={n}.png'), dpi=300)\nplt.close(fig)"})
