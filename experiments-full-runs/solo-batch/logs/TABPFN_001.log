[Step 9]
  Thought:     Create a Python script that loads the scikit-learn breast-cancer dataset, fits TabPFN and several baselines, and prints accuracy, ROC AUC, and timing.
  Action:      write_file({"relative_path":"run_experiment.py","content":"import time\nimport warnings\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, roc_auc_score\n\nresults = []\n\nX, y = load_breast_cancer(return_X_y=True)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.1, random_state=0, stratify=y)\n\n# TabPFN\ntry:\n    from tabpfn import TabPFNClassifier\n    t0 = time.time()\n    clf = TabPFNClassifier()\n    clf.fit(X_train, y_train)\n    preds = clf.predict(X_test)\n    probas = clf.predict_proba(X_test)[:, 1]\n    t = time.time() - t0\n    acc = accuracy_score(y_test, preds)\n    auc = roc_auc_score(y_test, probas)\n    results.append((\"TabPFN\", acc, auc, t))\nexcept Exception as e:\n    results.append((\"TabPFN\", str(e), None, None))\n\n# Scikit-learn baselines\nbaseline_constructors = {\n    \"LogisticRegression\": (\"sklearn.linear_model\", \"LogisticRegression\", {\"max_iter\":1000}),\n    \"RandomForest\": (\"sklearn.ensemble\", \"RandomForestClassifier\", {\"n_estimators\":100}),\n    \"SVC\": (\"sklearn.svm\", \"SVC\", {\"probability\":True}),\n    \"MLP\": (\"sklearn.neural_network\", \"MLPClassifier\", {\"max_iter\":500}),\n}\n\nfor name, (mod, clsname, kwargs) in baseline_constructors.items():\n    try:\n        modobj = __import__(mod, fromlist=[clsname])\n        Cls = getattr(modobj, clsname)\n        t0 = time.time()\n        clf = Cls(**kwargs)\n        clf.fit(X_train, y_train)\n        preds = clf.predict(X_test)\n        if hasattr(clf, \"predict_proba\"):\n            probas = clf.predict_proba(X_test)[:, 1]\n        else:\n            try:\n                probas = clf.decision_function(X_test)\n            except Exception:\n                probas = preds\n        t = time.time() - t0\n        acc = accuracy_score(y_test, preds)\n        auc = roc_auc_score(y_test, probas)\n        results.append((name, acc, auc, t))\n    except Exception as e:\n        results.append((name, str(e), None, None))\n\n# XGBoost if available\ntry:\n    from xgboost import XGBClassifier\n    t0 = time.time()\n    clf = XGBClassifier(use_label_encoder=False, eval_metric='logloss')\n    clf.fit(X_train, y_train)\n    preds = clf.predict(X_test)\n    probas = clf.predict_proba(X_test)[:, 1]\n    t = time.time() - t0\n    acc = accuracy_score(y_test, preds)\n    auc = roc_auc_score(y_test, probas)\n    results.append((\"XGBoost\", acc, auc, t))\nexcept Exception as e:\n    results.append((\"XGBoost\", str(e), None, None))\n\n# Print results\nfor r in results:\n    name = r[0]\n    if isinstance(r[1], str):\n        print(f\"{name}: ERROR: {r[1]}\")\n    else:\n        acc, auc, t = r[1], r[2], r[3]\n        print(f\"{name}: accuracy={acc:.4f}, roc_auc={auc:.4f}, time={t:.2f}s\")\n"})
